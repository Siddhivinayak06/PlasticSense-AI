PROJECT_NAME="PlasticSense AI Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
LOG_LEVEL="INFO"
HOST="127.0.0.1"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-your-postgresql-password"
POSTGRES_DB="plasticsense_db"
# Optional: overrides the PostgreSQL variables above when non-empty.
DATABASE_URL=""
ML_SERVICE_URL="http://127.0.0.1:8001"
ML_SERVICE_TIMEOUT_SECONDS=10
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10

# Supabase (see docs/RUNNING_LOCALLY.md). Use the Session pooler URI, URL-encode the password.
# DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_KEY="<server-side secret service role key - never expose to frontend>"
# SUPABASE_JWT_SECRET="<optional: jwt secret from supabase project api settings>"
# ADMIN_EMAILS='["admin@wastesense.ai"]'
DB_FORCE_SQLITE=false
SEED_SAMPLE_DATA=false
INFERENCE_RATE_LIMIT_PER_MINUTE=30
MAX_BATCH_FILES=10
